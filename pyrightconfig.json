{
  "venvPath": ".",
  "venv": ".venv",
  "typeCheckingMode": "basic",
  "include": [
    "src", "tests"
  ],
  "exclude": [
    "**/data",
    "**/parser",
    "**/__pycache__",
    "**/.*",
    "wrk"
  ],
  "reportMissingImports": "error",
  "reportMissingTypeStubs": false,
  "pythonVersion": "3.14",
  "pythonPlatform": "Linux",
  "useLibraryCodeForTypes": true
}
